{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["dub1"],
  "functions": {
    "api/cron/update.ts": {
      "maxDuration": 300,
      "memory": 2048
    },
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/update", "schedule": "0 18 * * 0" },
    { "path": "/api/cron/update", "schedule": "0 6 * * 1-5" },
    { "path": "/api/cron/update", "schedule": "0 9 * * 1-5" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(icon-192.png|icon-512.png|icon.svg|apple-touch-icon.png|favicon-32x32.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

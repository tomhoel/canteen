# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# screenshots & debug images
*.png
!public/**/*.png
public/images/*
!public/images/master-plate-ref.png
!public/images/closed-plates/
public/images_nobg/*
public/history/*

# playwright MCP test artefacts
/.playwright-mcp/

# logs
update.log

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which is the only documentation of what these are.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# TanStack Router's generate cache — written by `npm run build`, never committed
.tanstack/

# Moat task system
.moat/

# Claude Code configuration
.claude/
.env*.local
clear-cache.js
.superpowers/

# Agent/skill caches (Gemini CLI, superpowers, etc.) — never commit
.agent/
.agents/
.gemini/
skills/
skills-lock.json

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# screenshots & debug images
*.png
!public/**/*.png
# Source-only artwork lives in assets/source-images/ so Vite never copies it
# into dist/. It was under public/, which shipped 1.7 MB of master-plate-ref.png
# and closed-plate copies on every deploy that no client ever requests: the app
# reads the closed plates from Supabase, and image.service.ts fetches the master
# reference from Supabase too. Only scripts/upload-*.cjs read these files.
public/images/*
public/images_nobg/*
public/history/*

# playwright MCP test artefacts
/.playwright-mcp/

# logs
update.log

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which is the only documentation of what these are.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# TanStack Router's generate cache — written by `npm run build`, never committed

# Moat task system
.moat/

# Claude Code configuration
.claude/
.env*.local
clear-cache.js
.superpowers/

# Agent/skill caches (Gemini CLI, superpowers, etc.) — never commit
.agent/
.agents/
.gemini/
skills/
skills-lock.json
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

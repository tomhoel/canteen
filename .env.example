# Copy to .env for local runs (`npm run dev`, `npm run update`). tsx and Vite
# both pick it up. On Vercel these live in the project's Environment Variables.
#
# Nothing here is a real value. The two NEXT_PUBLIC_ ones are public by design
# and also hardcoded as fallbacks in src/lib/constants.ts, which is why the
# client build needs no environment at all.

# ── Read path (the app) ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Write path (the updater only) ─────────────────────────────────────────
# The updater refuses to write with the anon key. Without this, every run
# throws before touching the database — deliberately.
SUPABASE_SERVICE_ROLE_KEY=

# Dish origins, descriptions and plate images. Absent means every dish falls
# back to pattern copy and no plate is ever drawn; the run still succeeds.
GEMINI_API_KEY=

# ── Cron ──────────────────────────────────────────────────────────────────
# /api/cron/update fails closed without this: it answers 503 and nothing
# updates, rather than letting anyone trigger paid image generation. Vercel
# sends it as `Authorization: Bearer $CRON_SECRET` on scheduled invocations.
CRON_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────
# Operational alerts from the updater: failed runs, skipped weeks, canteens
# that would not scrape, dishes the model has been given up on. Every
# sendCronAlert call silently no-ops without it — as it does in production
# today — so the cron JSON response and Vercel logs are the only signal until
# this is set. Any Slack incoming-webhook URL.
SLACK_WEBHOOK_URL=

# Vote tallies. Absent means voting is unavailable and the menu still renders.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

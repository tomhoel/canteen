# Copy to .env for local runs (`npm run dev`, `npm run update`). tsx and Vite
# both pick it up. On Vercel these live in the project's Environment Variables.

# ── Primary Database & Caching (Upstash Redis) ────────────────────────────
# Redis is the primary datastore for weekly menus, dish cache, and attendance,
# as well as the cache for grocery searches and AI recipes.
# The Upstash marketplace integration on Vercel automatically sets these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── Image Storage (Vercel Blob) ───────────────────────────────────────────
# Vercel Blob stores plate images and reference plates.
# Automatically set by Vercel when attaching a Blob Store.
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_BLOB_BASE_URL=

# ── AI Generation (Gemini) ────────────────────────────────────────────────
# Dish origins, descriptions, title shortening, and plate illustrations.
# Absent means dishes fall back to pattern copy and no plate is drawn.
GEMINI_API_KEY=

# ── Cron ──────────────────────────────────────────────────────────────────
# /api/cron/update fails closed without this: answers 503 rather than letting
# unauthenticated callers trigger paid image generation.
# Vercel sends it as `Authorization: Bearer $CRON_SECRET` on scheduled cron runs.
CRON_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────
# Operational alerts from the updater: failed runs, skipped weeks, canteens
# that would not scrape, dishes given up on. Any Slack incoming-webhook URL.
SLACK_WEBHOOK_URL=

# Grocery prices for a dish's ingredients (kassal.app). Absent means /api/deals
# answers with no offers; the recipe and the menu are unaffected.
KASSAL_API_KEY=

# Which MENY store the ingredient search prices against. Defaults to MENY Bryn
# (7080001150488), which is the one within walking distance.
MENY_DEFAULT_STORE_ID=

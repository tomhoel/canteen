# Copy to .env for local runs (`npm run dev`, `npm run update`). tsx and Vite
# both pick it up. On Vercel these live in the project's Environment Variables.
#
# Nothing here is a real value. The two NEXT_PUBLIC_ ones are public by design
# and also hardcoded as fallbacks in src/lib/constants.ts, which is why the
# client build needs no environment at all.

# ── Read path (the app) ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Write path (the updater, and casting a vote) ──────────────────────────
# The updater refuses to write with the anon key. Without this, every run
# throws before touching the database — deliberately.
#
# /api/attendance needs it too: canteen_attendance carries a read policy and
# no write policies, so a vote cast with the anon key is rejected by RLS. It
# now fails loudly rather than answering 200 and dropping the vote.
SUPABASE_SERVICE_ROLE_KEY=

# Dish origins, descriptions and plate images. Absent means every dish falls
# back to pattern copy and no plate is ever drawn; the run still succeeds.
GEMINI_API_KEY=

# ── Cron ──────────────────────────────────────────────────────────────────
# /api/cron/update fails closed without this: it answers 503 and nothing
# updates, rather than letting anyone trigger paid image generation. Vercel
# sends it as `Authorization: Bearer $CRON_SECRET` on scheduled invocations.
CRON_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────
# Operational alerts from the updater: failed runs, skipped weeks, canteens
# that would not scrape, dishes the model has been given up on. Every
# sendCronAlert call silently no-ops without it — as it does in production
# today — so the cron JSON response and Vercel logs are the only signal until
# this is set. Any Slack incoming-webhook URL.
SLACK_WEBHOOK_URL=

# Grocery prices for a dish's ingredients (kassal.app). Absent means /api/deals
# answers with no offers; the recipe and the menu are unaffected.
KASSAL_API_KEY=

# Which MENY store the ingredient search prices against. Defaults to MENY Bryn
# (7080001150488), which is the one within walking distance.
MENY_DEFAULT_STORE_ID=

# ── Caching (optional) ────────────────────────────────────────────────────
# Redis in front of the stored menu, the grocery searches and the AI recipes.
# Absent means every request goes to its origin: correct, slower, and it
# re-bills the model for recipes it has already written. It has never held the
# vote tallies, despite what this file used to say — those live in Supabase.
#
# Either naming works, and only one pair is needed. The Upstash marketplace
# integration provisions UPSTASH_REDIS_REST_*; the older Vercel KV integration
# provisions KV_REST_API_*. They used to be read inconsistently — the menu
# cache took either, everything else took only KV_REST_API_*, and this file
# documented only UPSTASH_*, so following it left every other cache silently
# switched off.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
